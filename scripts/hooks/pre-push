#!/usr/bin/env bash
# pre-push 钩子 —— 推送前运行内容检查
# 由 scripts/install-hook.sh 安装到 .git/hooks/pre-push
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$ROOT" ] || exit 0
NODE_BIN="$(command -v node || true)"
SCANNER="$ROOT/scripts/check-content.mjs"
[ -n "$NODE_BIN" ] || { echo "pre-push: 未找到 node,跳过扫描"; exit 0; }
[ -f "$SCANNER" ] || { echo "pre-push: 缺少 $SCANNER,跳过扫描"; exit 0; }

echo "== pre-push: 内容检查 =="
FAILED=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha}" ] || continue
  case "${local_sha}" in 0000000000000000000000000000000000000000) continue;; esac
  if [ "${remote_sha}" = "0000000000000000000000000000000000000000" ]; then
    RANGE="${local_sha}^..${local_sha}"
  else
    RANGE="${remote_sha}..${local_sha}"
  fi
  node "$SCANNER" --range="$RANGE" || FAILED=1
done
if [ "$FAILED" = "1" ]; then
  echo "pre-push: 存在命中,已阻止推送"
  exit 1
fi
echo "== pre-push: 扫描通过 =="
exit 0
